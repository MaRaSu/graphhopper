{
  "description": "Trailmap area routing rules - defines which OSM area polygons are passable. Curated to small 'connector' areas that frequently lack mapped internal ways. Large landscape polygons (parks, recreation_ground, camp_site, motorway service areas) are intentionally excluded: area routing only stores the polygon PERIMETER, so for large areas the boundary is a detour (e.g. following a lake shore or field edge) rather than a useful crossing, and those areas almost always already have their internal paths mapped.",
  "rules": [
    {
      "name": "parking_lots",
      "description": "Parking lots at trailheads and other locations",
      "required_tags": {
        "amenity": "parking"
      },
      "forbidden_tags": [],
      "area_check": "explicit_or_closed",
      "access": {
        "foot": true,
        "bike": true,
        "car": false
      }
    },
    {
      "name": "pedestrian_areas",
      "description": "Pedestrian plazas and squares with explicit area=yes",
      "required_tags": {
        "highway": "pedestrian",
        "area": "yes"
      },
      "forbidden_tags": [],
      "area_check": "explicit",
      "access": {
        "foot": true,
        "bike": true,
        "car": false
      }
    },
    {
      "name": "squares",
      "description": "Town squares and plazas",
      "required_tags": {
        "place": "square"
      },
      "forbidden_tags": [],
      "area_check": "explicit_or_closed",
      "access": {
        "foot": true,
        "bike": true,
        "car": false
      }
    },
    {
      "name": "rest_areas",
      "description": "Highway rest areas",
      "required_tags": {
        "highway": "rest_area"
      },
      "forbidden_tags": [],
      "area_check": "explicit_or_closed",
      "access": {
        "foot": true,
        "bike": true,
        "car": false
      }
    },
    {
