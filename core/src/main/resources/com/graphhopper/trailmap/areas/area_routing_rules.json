      "description": "Picnic areas",
      "required_tags": {
        "tourism": "picnic_site"
      },
      "forbidden_tags": [],
      "area_check": "explicit_or_closed",
      "access": {
        "foot": true,
        "bike": true,
        "car": false
      }
    },
    {
      "name": "platform",
      "description": "Public transport platforms",
      "required_tags": {
        "public_transport": "platform"
      },
      "forbidden_tags": [],
      "area_check": "explicit_or_closed",
      "access": {
