{
  "distance_influence": 50,
  "priority": [
    { "if": "true", "multiply_by": "(2.0 + trail_factor) * 0.3333" },
    { "if": "!foot_access", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0.1" },

    { "if": "predicted_highway == CYCLEWAY", "multiply_by": "1" },
    { "if": "predicted_highway == OUTDOOR_WAY", "multiply_by": "1.2" },
    { "if": "predicted_highway == OUTDOOR_PATH", "multiply_by": "1.2" },
    { "if": "predicted_highway == PATH", "multiply_by": "1" },
    { "if": "predicted_highway == GOOD_TRACK", "multiply_by": "1" },
    { "if": "predicted_highway == ROUGH_TRACK", "multiply_by": "1" },
    { "if": "predicted_highway == MINOR_ROAD", "multiply_by": "0.8" },
    { "if": "predicted_highway == SERVICE_ROAD", "multiply_by": "0.8" },
    { "if": "predicted_highway == SERVICE_DRIVEWAY", "multiply_by": "0.6" },
    { "if": "predicted_highway == MAJOR_ROAD", "multiply_by": "0.5" },
    { "if": "predicted_highway == MOTORWAY", "multiply_by": "0" },

    { "if": "predicted_surface == MUD", "multiply_by": "0.5" },
    { "if": "predicted_surface == SAND", "multiply_by": "0.8" }
  ],
  "speed": [
    { "if": "true", "limit_to": "5" },

    { "if": "predicted_surface == MUD", "limit_to": "3" },
    { "if": "predicted_surface == SAND", "limit_to": "3.5" },
    { "if": "road_environment == FERRY", "limit_to": "10" }
  ]
}
