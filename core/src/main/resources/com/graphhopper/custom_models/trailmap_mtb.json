    { "if": "predicted_highway == MOTORWAY", "multiply_by": "0" },

    { "if": "predicted_surface == MUD", "multiply_by": "0.4" },
    { "if": "predicted_surface == SAND", "multiply_by": "0.5" }
  ],
  "speed": [
    { "if": "true", "limit_to": "20" },
