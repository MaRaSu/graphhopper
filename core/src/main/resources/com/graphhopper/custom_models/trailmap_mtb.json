    { "if": "mtb_scale == ONE", "multiply_by": "1.2" },
    { "if": "mtb_scale == TWO", "multiply_by": "1.0" },
    { "if": "mtb_scale == THREE", "multiply_by": "0.7" },
    { "if": "mtb_scale == FOUR", "multiply_by": "0.4" },
    { "if": "mtb_scale == FIVE", "multiply_by": "0.2" },
    { "if": "mtb_scale == SIX", "multiply_by": "0.1" },
    { "if": "mtb_scale == UNKNOWN", "multiply_by": "0.5" },

    { "if": "predicted_highway == OUTDOOR_WAY", "multiply_by": "1.1" },
    { "if": "predicted_highway == OUTDOOR_PATH", "multiply_by": "1.2" },
