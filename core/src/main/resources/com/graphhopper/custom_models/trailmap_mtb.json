    { "if": "mtb_scale == SIX", "limit_to": "3" },
    { "if": "mtb_scale == UNKNOWN", "limit_to": "10" },
    { "if": "mtb_scale == FERRY", "limit_to": "15" },
    { "if": "road_environment == FERRY", "limit_to": "15" },
    { "if": "predicted_surface == MUD", "limit_to": "8" },
