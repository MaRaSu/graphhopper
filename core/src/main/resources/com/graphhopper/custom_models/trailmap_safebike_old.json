// Trailmap Safe Bike Profile
// For commuting and city cycling - prioritizes safety and bike infrastructure
//
// Priorities:
// - Cycleways and designated bike paths (highest)
// - Quiet residential streets
// - Avoids major roads and traffic
// - Prefers paved surfaces

{
  "distance_influence": 15,
  "priority": [
    { "if": "true", "multiply_by": "1.0" },
    { "if": "!bike_access && (!backward_bike_access || roundabout)", "multiply_by": "0" },
    { "else_if": "!bike_access && backward_bike_access", "multiply_by": "0.2" },
    { "if": "road_environment == FERRY", "multiply_by": "0.5" },

    { "if": "predicted_highway == CYCLEWAY", "multiply_by": "1.5" },
    { "if": "predicted_highway == OUTDOOR_WAY", "multiply_by": "1.3" },
    { "if": "predicted_highway == OUTDOOR_PATH", "multiply_by": "1.1" },
    { "if": "predicted_highway == MINOR_ROAD", "multiply_by": "1.0" },
    { "if": "predicted_highway == SERVICE_ROAD", "multiply_by": "0.9" },
    { "if": "predicted_highway == MAJOR_ROAD", "multiply_by": "0.5" },
    { "if": "predicted_highway == MOTORWAY", "multiply_by": "0" },

    { "if": "predicted_highway == GOOD_TRACK", "multiply_by": "0.7" },
    { "if": "predicted_highway == ROUGH_TRACK", "multiply_by": "0.3" },
    { "if": "predicted_highway == PATH", "multiply_by": "0.4" },

    { "if": "predicted_surface == ASPHALT", "multiply_by": "1.1" },
    { "if": "predicted_surface == COMPACTED", "multiply_by": "1.0" },
    { "if": "predicted_surface == FINE_GRAVEL", "multiply_by": "0.9" },
    { "if": "predicted_surface == MEDIUM_GRAVEL", "multiply_by": "0.6" },
    { "if": "predicted_surface == ROUGH_GRAVEL", "multiply_by": "0.3" },
    { "if": "predicted_surface == GROUND", "multiply_by": "0.4" },
    { "if": "predicted_surface == SAND", "multiply_by": "0.2" },
    { "if": "predicted_surface == MUD", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "25" },
    { "if": "predicted_highway == CYCLEWAY", "limit_to": "22" },
    { "if": "predicted_highway == OUTDOOR_WAY", "limit_to": "20" },
    { "if": "predicted_highway == OUTDOOR_PATH", "limit_to": "16" },
    { "if": "predicted_highway == GOOD_TRACK", "limit_to": "14" },
    { "if": "predicted_highway == ROUGH_TRACK", "limit_to": "8" },
    { "if": "predicted_highway == PATH", "limit_to": "10" },

    { "if": "predicted_surface == MEDIUM_GRAVEL", "limit_to": "14" },
    { "if": "predicted_surface == ROUGH_GRAVEL", "limit_to": "10" },
    { "if": "predicted_surface == GROUND", "limit_to": "12" },
    { "if": "predicted_surface == SAND", "limit_to": "6" },
    { "if": "predicted_surface == MUD", "limit_to": "4" },

    { "if": "road_environment == FERRY", "limit_to": "15" },
    { "if": "!bike_access && backward_bike_access", "limit_to": "4" }
  ]
}
